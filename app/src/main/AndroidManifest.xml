<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.mappy.fizzbuzz">

    <application
        android:name=".application.FizzApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FizzBuzz">
        <activity android:name=".application.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="com.google.firebase.analytics.APP_MEASUREMENT_SERVICE"
            android:value="true" />
        <meta-data
            android:name="com.google.firebase.analytics.MEASUREMENT_ID"
            android:value="G-XXXXXXXXXX" />
    </application>

</manifest>
